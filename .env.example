# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.
#
# The point of every DB_* and AZURE_AD_* value below is that they are just
# config. The same code runs against local Docker Postgres today and Azure
# Postgres Flexible Server later — only these values change, nothing in src/.

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────
# Local (docker-compose): host=localhost, ssl=false — see docker-compose.yml
# Azure Postgres Flexible Server: host=<name>.postgres.database.azure.com,
# ssl=true is required by Azure, the connection will be refused without it.
DB_HOST=localhost
DB_PORT=5432
# The app's own restricted role — no DDL rights, and Row-Level Security
# actually applies to it. Never the superuser below.
DB_USERNAME=mmm_app
DB_PASSWORD=change-me-locally
# The Postgres bootstrap superuser — migrations only (see data-source.ts).
# RLS cannot apply to this role no matter what, Postgres exempts superusers
# unconditionally, so the app must never connect as this one.
DB_ADMIN_USERNAME=mmm_dev
DB_ADMIN_PASSWORD=change-me-locally
DB_NAME=mmm_dev
DB_SSL=false

# Never true anywhere but a throwaway local sandbox. Schema changes only ever
# go through a migration (npm run migration:run), even in development — the
# multi-tenant schema and its Row-Level Security policies are too easy to
# desync silently otherwise.
DB_SYNCHRONIZE=false

# Log every SQL statement to the console. Useful locally, noisy in Azure.
DB_LOGGING=true

# ── Microsoft Entra ID (auth) ────────────────────────────────────────────
# From your API's own app registration in Entra ID (App registrations →
# your app → Overview). AZURE_AD_TENANT_ID is either the specific tenant GUID
# for a single-tenant registration, or the literal word "common" if the app
# registration is configured as multi-tenant (accounts in any organization).
AZURE_AD_TENANT_ID=common
# The audience your API expects on incoming tokens — the Application ID URI
# or Client ID from that same app registration's "Expose an API" blade.
AZURE_AD_AUDIENCE=api://REPLACE-WITH-YOUR-APP-ID-URI

# Dev-only escape hatch: when true, every request is treated as an already
# authenticated fake user instead of validating a real Entra token, so you
# can build and test other routes before an app registration exists.
# The app refuses to start with this on if NODE_ENV=production.
AUTH_DEV_BYPASS=true
